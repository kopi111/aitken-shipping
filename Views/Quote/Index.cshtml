@model QuotePageViewModel
@{
    ViewData["Title"] = "Get a quote";
}

<div class="page-head">
    <div class="container">
        <span class="waybill">Rate desk</span>
        <h1>Get an instant quote</h1>
        <p>An itemised manifest in seconds — no sign-up, no surprises.</p>
    </div>
</div>

<section class="section">
    <div class="container split">
        <div class="panel">
            <form asp-controller="Quote" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Request.OriginParish">Origin parish</label>
                        <select asp-for="Request.OriginParish" asp-items="@(new SelectList(Model.Parishes))">
                            <option value="">Select…</option>
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="Request.DestinationParish">Destination parish</label>
                        <select asp-for="Request.DestinationParish" asp-items="@(new SelectList(Model.Parishes))">
                            <option value="">Select…</option>
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="Request.WeightKg">Weight (kg)</label>
                        <input asp-for="Request.WeightKg" type="number" step="0.1" min="0.1" placeholder="e.g. 2.5" />
                        <span asp-validation-for="Request.WeightKg" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Request.Service">Service lane</label>
                        <select asp-for="Request.Service" asp-items="Html.GetEnumSelectList<AitkenShipping.Models.ServiceLevel>()"></select>
                    </div>
                    <div class="field"><label asp-for="Request.LengthCm">Length (cm)</label><input asp-for="Request.LengthCm" type="number" min="0" placeholder="optional" /></div>
                    <div class="field"><label asp-for="Request.WidthCm">Width (cm)</label><input asp-for="Request.WidthCm" type="number" min="0" placeholder="optional" /></div>
                    <div class="field"><label asp-for="Request.HeightCm">Height (cm)</label><input asp-for="Request.HeightCm" type="number" min="0" placeholder="optional" /></div>
                    <div class="field"><label asp-for="Request.DeclaredValueJmd">Declared value (JMD)</label><input asp-for="Request.DeclaredValueJmd" type="number" min="0" placeholder="0 = no insurance" /></div>
                    <div class="field check full">
                        <input asp-for="Request.IsFragile" type="checkbox" />
                        <label asp-for="Request.IsFragile">This shipment is fragile (+12% handling)</label>
                    </div>
                </div>
                <p class="help mt-1">CHARGED ON MAX(ACTUAL, DIMENSIONAL) — DIM = L×W×H ÷ 5000</p>
                <button class="btn btn-primary mt-1" type="submit">Calculate manifest</button>
            </form>

            @if (Model.Result is not null)
            {
                var r = Model.Result;
                <div class="manifest">
                    <span class="waybill green">Manifest</span>
                    <h2 class="mt-1" style="margin-bottom:0.6rem;">@r.Service lane</h2>
                    <p><span class="chip">⏱ ~@r.TransitBusinessDays business day@(r.TransitBusinessDays == 1 ? "" : "s")</span>
                       &nbsp;<span class="chip">⚖ @r.ChargeableWeightKg kg chargeable</span></p>
                    <ul class="line-items">
                        @foreach (var item in r.LineItems)
                        {
                            <li><span>@item.Label</span><span>$@item.AmountJmd.ToString("N2")</span></li>
                        }
                    </ul>
                    <div class="total-row">
                        <span class="lbl">Total · JMD</span>
                        <span class="amount">$@r.TotalJmd.ToString("N2")</span>
                    </div>
                    <a class="btn btn-green btn-block mt-2" asp-controller="Book" asp-action="Index">Book this shipment</a>
                </div>
            }
        </div>

        <div class="aside">
            <h3>Good to know</h3>
            <ul>
                <li>All prices in Jamaican dollars.</li>
                <li>Same-parish delivery is discounted automatically.</li>
                <li>Add a declared value to insure your goods (1.5%).</li>
                <li>Dimensional weight stops you paying for air.</li>
            </ul>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
