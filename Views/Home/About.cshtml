@{
    ViewData["Title"] = "About";
}

<div class="page-head">
    <div class="container">
        <span class="waybill">Who we are</span>
        <h1>Delivery, run like a desk</h1>
        <p>A Jamaican courier built on tracking you can trust.</p>
    </div>
</div>

<section class="section">
    <div class="container split">
        <div class="panel">
            <span class="waybill">Our story</span>
            <h2 class="mt-1">The black hole between pickup and door</h2>
            <p style="color:var(--fog);">Aitken Shipping started with one frustration: parcels that vanished between pickup and delivery. So we built a courier that works like an operations desk — every shipment on the board, carrying a waybill number from the first scan, priced upfront with nothing hidden.</p>
            <p style="color:var(--fog);">Today we move documents, e-commerce orders, and freight across all fourteen parishes — from Negril to Port Antonio — with delivery windows we hold ourselves to.</p>
            <p style="color:var(--fog);">No guesswork. Just your parcel, moving.</p>
        </div>
        <div class="aside">
            <h3>Why shippers choose us</h3>
            <ul>
                <li>Live tracking on every shipment</li>
                <li>Itemised, upfront manifests</li>
                <li>Island-wide coverage</li>
                <li>Fragile handling &amp; insurance</li>
                <li>Real people on the phone</li>
            </ul>
            <a class="btn btn-primary btn-block mt-2" asp-controller="Home" asp-action="Contact">Talk to dispatch</a>
        </div>
    </div>
</section>
