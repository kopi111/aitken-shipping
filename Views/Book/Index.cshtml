@model BookingPageViewModel
@{
    ViewData["Title"] = "Book a shipment";
}

<div class="page-head">
    <div class="container">
        <span class="waybill">New waybill</span>
        <h1>Book a shipment</h1>
        <p>Fill in the details and your tracking number is issued instantly.</p>
    </div>
</div>

<section class="section">
    <div class="container split">
        <div class="panel">
            <form asp-controller="Book" asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Request.SenderName">Sender</label>
                        <input asp-for="Request.SenderName" type="text" placeholder="Who is sending?" />
                        <span asp-validation-for="Request.SenderName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Request.RecipientName">Recipient</label>
                        <input asp-for="Request.RecipientName" type="text" placeholder="Who receives it?" />
                        <span asp-validation-for="Request.RecipientName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Request.OriginParish">Origin parish</label>
                        <select asp-for="Request.OriginParish" asp-items="@(new SelectList(Model.Parishes))"><option value="">Select…</option></select>
                    </div>
                    <div class="field">
                        <label asp-for="Request.DestinationParish">Destination parish</label>
                        <select asp-for="Request.DestinationParish" asp-items="@(new SelectList(Model.Parishes))"><option value="">Select…</option></select>
                    </div>
                    <div class="field">
                        <label asp-for="Request.WeightKg">Weight (kg)</label>
                        <input asp-for="Request.WeightKg" type="number" step="0.1" min="0.1" placeholder="e.g. 2.5" />
                        <span asp-validation-for="Request.WeightKg" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Request.Service">Service lane</label>
                        <select asp-for="Request.Service" asp-items="Html.GetEnumSelectList<AitkenShipping.Models.ServiceLevel>()"></select>
                    </div>
                    <div class="field check full">
                        <input asp-for="Request.IsFragile" type="checkbox" />
                        <label asp-for="Request.IsFragile">This shipment is fragile (+12% handling)</label>
                    </div>
                </div>
                <button class="btn btn-primary mt-1" type="submit">Confirm booking</button>
            </form>
        </div>

        <div class="aside">
            <h3>What happens next</h3>
            <ul>
                <li>We price the shipment instantly.</li>
                <li>A waybill number is issued on the spot.</li>
                <li>Drop at any Aitken depot or request pickup.</li>
                <li>Follow it live on the board.</li>
            </ul>
            <a class="btn btn-ghost btn-block mt-2" asp-controller="Quote" asp-action="Index">Price it first</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
